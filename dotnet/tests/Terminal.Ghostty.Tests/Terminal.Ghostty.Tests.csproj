<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GhosttyTestRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</GhosttyTestRid>
    <GhosttyTestRid Condition="'$(GhosttyTestRid)' == '' and '$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">win-arm64</GhosttyTestRid>
    <GhosttyTestRid Condition="'$(GhosttyTestRid)' == ''">win-x64</GhosttyTestRid>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Terminal.Ghostty\Terminal.Ghostty.csproj" />
    <ProjectReference Include="..\..\src\Terminal.Control\Terminal.Control.csproj" />
    <None Include="..\..\native\ghostty\$(GhosttyTestRid)\ghostty-vt.dll"
          Link="ghostty-vt.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
