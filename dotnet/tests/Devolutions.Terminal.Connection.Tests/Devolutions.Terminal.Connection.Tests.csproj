<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <LinuxPtyTestRid Condition="$([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('linux-'))">$(NETCoreSdkPortableRuntimeIdentifier)</LinuxPtyTestRid>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Devolutions.Terminal.Connection\Devolutions.Terminal.Connection.csproj" />
    <None Include="..\..\native\linux-pty\$(LinuxPtyTestRid)\dt-pty-host"
          Link="dt-pty-host"
          Condition="'$(LinuxPtyTestRid)' != ''"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
