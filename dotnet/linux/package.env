# Canonical Linux package metadata. Keep versions out of this file; callers pass
# the version from Directory.Build.props or the release pipeline.
PACKAGE_NAME=devolutions-terminal
APP_ID=com.devolutions.Terminal
DISPLAY_NAME="Devolutions Terminal"
SUMMARY="NativeAOT terminal emulator with tabs and panes"
HOMEPAGE=https://github.com/Devolutions/devolutions-terminal
LICENSE_ID="MIT AND OFL-1.1"
SBOM_LICENSE_ID="MIT AND OFL-1.1"
INSTALL_DIR=/opt/devolutions-terminal
DESKTOP_SCHEME=x-scheme-handler/dterm
RUNTIME_DEPENDENCIES_DEB="libc6, libfontconfig1, libx11-6, libice6, libsm6"
RUNTIME_DEPENDENCIES_RPM="glibc, fontconfig, libX11, libICE, libSM"
