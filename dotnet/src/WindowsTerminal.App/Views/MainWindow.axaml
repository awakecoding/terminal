<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WindowsTerminal.Views.MainWindow"
        x:CompileBindings="True"
        Title="Windows Terminal"
        Width="1100"
        Height="700"
        MinWidth="480"
        MinHeight="320"
        Background="#0C0C0C"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        SizeChanged="MainWindow_OnSizeChanged">
  <DockPanel>
    <Border x:Name="TitleBar"
            DockPanel.Dock="Top"
            Height="40"
            Background="#202020"
            PointerPressed="TitleBar_OnPointerPressed">
      <Grid ColumnDefinitions="Auto,*" Margin="8,0,138,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <ScrollViewer x:Name="TabScrollViewer"
                       MaxWidth="720"
                       HorizontalScrollBarVisibility="Hidden"
                       VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TabStrip"
                       Orientation="Horizontal"
                       Spacing="0" />
          </ScrollViewer>
          <Button Classes="icon"
                 Click="NewTab_OnClick"
                 AutomationProperties.Name="New tab"
                 ToolTip.Tip="New tab (Ctrl+Shift+T)">
            <TextBlock Text="+" FontSize="18" />
          </Button>
          <Button x:Name="MenuButton"
                 Classes="icon"
                 Width="24"
                 Click="Menu_OnClick"
                 AutomationProperties.Name="New tab menu"
                 ToolTip.Tip="New tab menu">
            <TextBlock Text="⌄" FontSize="14" />
          </Button>
        </StackPanel>
        <Border Grid.Column="1" MinWidth="45" />
      </Grid>
    </Border>
    <Grid>
      <Panel x:Name="TerminalHost" Background="#0C0C0C" />
      <Border x:Name="FindBar"
              IsVisible="False"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="12"
              Padding="8"
              CornerRadius="4"
              Background="#F02B2B2B">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBox x:Name="FindBox"
                   Width="260"
                   Watermark="Find"
                   KeyDown="FindBox_OnKeyDown" />
          <Button Content="Previous" Click="FindPrevious_OnClick" />
          <Button Content="Next" Click="FindNext_OnClick" />
          <Button Content="Close" Click="CloseFind_OnClick" />
        </StackPanel>
      </Border>
      <Border x:Name="CommandPalette"
              IsVisible="False"
              Width="520"
              MaxHeight="440"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,56,0,0"
              Padding="12"
              CornerRadius="6"
              Background="#F02B2B2B">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <TextBox x:Name="CommandPaletteQuery"
                   Watermark="Search actions"
                   TextChanged="CommandPaletteQuery_OnTextChanged"
                   KeyDown="CommandPaletteQuery_OnKeyDown" />
          <ListBox x:Name="CommandPaletteList"
                   Grid.Row="1"
                   DoubleTapped="CommandPaletteList_OnDoubleTapped" />
        </Grid>
      </Border>
      <Border x:Name="NotificationToast"
              IsVisible="False"
              MaxWidth="420"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="16"
              Padding="14"
              CornerRadius="6"
              Background="#F03A3A3A"
              AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="4">
          <TextBlock x:Name="NotificationTitle"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="NotificationBody"
                     AutomationProperties.LiveSetting="Polite"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
