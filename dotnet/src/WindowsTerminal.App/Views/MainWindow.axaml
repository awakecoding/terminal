<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WindowsTerminal.Views.MainWindow"
        x:CompileBindings="True"
        Title="Windows Terminal"
        Width="1100"
        Height="700"
        MinWidth="480"
        MinHeight="320"
        Background="#0C0C0C"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">
  <DockPanel>
    <Border x:Name="TitleBar"
            DockPanel.Dock="Top"
            Height="40"
            Background="#2B2B2B"
            PointerPressed="TitleBar_OnPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,140,0">
        <Button Grid.Column="0"
                Classes="icon"
                Click="Menu_OnClick"
                ToolTip.Tip="Menu">
          <TextBlock Text="☰" FontSize="16" />
        </Button>
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TabStrip"
                      Orientation="Horizontal"
                      Spacing="0" />
        </ScrollViewer>
        <Button Grid.Column="2"
                Classes="icon"
                Click="NewTab_OnClick"
                ToolTip.Tip="New tab (Ctrl+Shift+T)">
          <TextBlock Text="+" FontSize="18" />
        </Button>
      </Grid>
    </Border>
    <Grid>
      <Panel x:Name="TerminalHost" Background="#0C0C0C" />
      <Border x:Name="FindBar"
              IsVisible="False"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="12"
              Padding="8"
              CornerRadius="4"
              Background="#F02B2B2B">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBox x:Name="FindBox"
                   Width="260"
                   Watermark="Find"
                   KeyDown="FindBox_OnKeyDown" />
          <Button Content="Previous" Click="FindPrevious_OnClick" />
          <Button Content="Next" Click="FindNext_OnClick" />
          <Button Content="Close" Click="CloseFind_OnClick" />
        </StackPanel>
      </Border>
      <Border x:Name="CommandPalette"
              IsVisible="False"
              Width="520"
              MaxHeight="440"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,56,0,0"
              Padding="12"
              CornerRadius="6"
              Background="#F02B2B2B">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <TextBox x:Name="CommandPaletteQuery"
                   Watermark="Search actions"
                   TextChanged="CommandPaletteQuery_OnTextChanged"
                   KeyDown="CommandPaletteQuery_OnKeyDown" />
          <ListBox x:Name="CommandPaletteList"
                   Grid.Row="1"
                   DoubleTapped="CommandPaletteList_OnDoubleTapped" />
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
