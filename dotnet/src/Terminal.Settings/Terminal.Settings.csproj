<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Microsoft.Terminal.Settings</RootNamespace>
    <Description>JSON settings model compatible with a Windows Terminal subset.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Terminal.Core\Terminal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Defaults\defaults.json" LogicalName="Microsoft.Terminal.Settings.defaults.json" />
    <EmbeddedResource Include="Defaults\userDefaults.json" LogicalName="Microsoft.Terminal.Settings.userDefaults.json" />
  </ItemGroup>
</Project>
