<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WindowsTerminal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot Condition="'$(Configuration)' == 'Debug'">false</PublishAot>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <DebugType>embedded</DebugType>
    <AssemblyName>WindowsTerminal</AssemblyName>
    <Product>Windows Terminal (.NET)</Product>
    <Description>NativeAOT Avalonia port of Windows Terminal.</Description>
    <GhosttyRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</GhosttyRid>
    <GhosttyRid Condition="'$(GhosttyRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</GhosttyRid>
    <GhosttyNativeName Condition="$([System.String]::Copy('$(GhosttyRid)').StartsWith('linux-'))">libghostty-vt.so</GhosttyNativeName>
    <GhosttyNativeName Condition="'$(GhosttyNativeName)' == ''">ghostty-vt.dll</GhosttyNativeName>
    <LinuxPtyRid Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">$(RuntimeIdentifier)</LinuxPtyRid>
    <LinuxPtyRid Condition="'$(LinuxPtyRid)' == '' and $([System.String]::Copy('$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('linux-'))">$(NETCoreSdkPortableRuntimeIdentifier)</LinuxPtyRid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <None Include="..\..\native\ghostty\$(GhosttyRid)\$(GhosttyNativeName)"
          Link="$(GhosttyNativeName)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\native\ghostty\LICENSE"
          Link="THIRD-PARTY-NOTICES-GHOSTTY.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\native\noto-emoji\LICENSE"
          Link="THIRD-PARTY-NOTICES-NOTO-EMOJI.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\native\linux-pty\$(LinuxPtyRid)\wt-pty-host"
          Link="wt-pty-host"
          Condition="'$(LinuxPtyRid)' != ''"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PublishWtCli" AfterTargets="Publish">
    <PropertyGroup>
      <_WindowsTerminalPublishDir Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_WindowsTerminalPublishDir>
      <_WindowsTerminalPublishDir Condition="!$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(PublishDir)'))</_WindowsTerminalPublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="..\WindowsTerminal.Cli\WindowsTerminal.Cli.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishAot=$(PublishAot);PublishDir=$(_WindowsTerminalPublishDir)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\WindowsTerminal.App\WindowsTerminal.App.csproj" />
    <ProjectReference Include="..\WindowsTerminal.Broker\WindowsTerminal.Broker.csproj" />
    <ProjectReference Include="..\WindowsTerminal.Cli\WindowsTerminal.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\..\res\terminal\images\terminal_contrast-white.ico" Link="Assets\terminal.ico" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="WindowsTerminal" />
    <TrimmerRootAssembly Include="WindowsTerminal.App" />
    <TrimmerRootAssembly Include="WindowsTerminal.Settings" />
  </ItemGroup>
</Project>
