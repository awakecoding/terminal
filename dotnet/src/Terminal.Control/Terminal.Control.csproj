<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Microsoft.Terminal.Control</RootNamespace>
    <Description>Avalonia terminal control that renders Microsoft.Terminal.Core.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Terminal.Core\Terminal.Core.csproj" />
    <ProjectReference Include="..\Terminal.Render\Terminal.Render.csproj" />
    <ProjectReference Include="..\Terminal.Connection\Terminal.Connection.csproj" />
    <ProjectReference Include="..\Terminal.Settings\Terminal.Settings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\..\res\fonts\CascadiaMono.ttf"
                      Link="Assets\Fonts\CascadiaMono.ttf" />
    <AvaloniaResource Include="..\..\..\res\fonts\CascadiaMonoItalic.ttf"
                      Link="Assets\Fonts\CascadiaMonoItalic.ttf" />
    <AvaloniaResource Include="..\..\native\noto-emoji\NotoColorEmoji.ttf"
                      Link="Assets\Fonts\NotoColorEmoji.ttf" />
  </ItemGroup>
</Project>
